<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SistemasOperacionaisQuestionsActivity">

    <ImageView
        android:id="@+id/img_SOLogo"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:layout_marginTop="50dp"
        android:scaleType="fitCenter"
        android:src="@drawable/so_symbol"
        app:layout_constraintBottom_toTopOf="@+id/content_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/img_SOLogo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txt_questao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pergunta"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <RadioGroup
            android:id="@+id/radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rb_alternativa1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alternativa 1"
                android:layout_marginBottom="8dp"/>

            <RadioButton
                android:id="@+id/rb_alternativa2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alternativa 2"
                android:layout_marginBottom="8dp"/>

            <RadioButton
                android:id="@+id/rb_alternativa3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alternativa 3"
                android:layout_marginBottom="8dp"/>

            <RadioButton
                android:id="@+id/rb_alternativa4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alternativa 4"
                android:layout_marginBottom="16dp"/>
        </RadioGroup>

        <Button
            android:id="@+id/btn_next"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Próxima"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>