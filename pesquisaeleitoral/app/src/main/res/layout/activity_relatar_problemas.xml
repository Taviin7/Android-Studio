<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RelatarProblemasActivity">

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/layoutProblemas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <TextView
                android:id="@+id/txt_titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="65dp"
                android:paddingBottom="12dp"
                android:text="Quais os principais problemas?"
                android:textSize="18sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cb_outro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Outro" />

        <EditText
            android:id="@+id/edt_outro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Digite outro problema"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btn_proximo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Próximo"
            android:layout_marginTop="20dp"
            android:backgroundTint="#302681"
            android:textColor="@color/white" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>